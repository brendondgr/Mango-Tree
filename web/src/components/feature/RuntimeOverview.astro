---
import StatusBadge from "../ui/StatusBadge.astro";
---

<section class="mx-auto grid max-w-6xl gap-6 px-5 py-10 md:grid-cols-[1.4fr_1fr]">
  <div>
    <p class="text-sm font-semibold uppercase text-[var(--accent)]">Local agent runtime</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold leading-tight text-[var(--text-primary)]">
      Scoped orchestration for agents, tools, memory, and workflows.
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--text-secondary)]">
      This skeleton reserves the frontend structure for a future dashboard without inventing runtime endpoints early.
    </p>
  </div>
  <div class="rounded-lg border border-[var(--border-color)] bg-[var(--surface-color)] p-5 shadow-[0_12px_32px_var(--shadow-color)]">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">Setup Status</h2>
      <StatusBadge tone="success" label="Skeleton" />
    </div>
    <dl class="mt-5 grid gap-3 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--text-muted)]">Frontend</dt>
        <dd class="font-medium text-[var(--text-primary)]">Astro + Svelte + React</dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--text-muted)]">Styling</dt>
        <dd class="font-medium text-[var(--text-primary)]">UnoCSS</dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-[var(--text-muted)]">Theme</dt>
        <dd class="font-medium text-[var(--text-primary)]">Pulse Light</dd>
      </div>
    </dl>
  </div>
</section>
