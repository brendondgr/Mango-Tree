LLM_BASE_URL=http://localhost:9090/v1
LLM_MODEL=default-model
LLM_API_KEY=

# Django debug. Leave unset (defaults to true) for local development.
# DJANGO_DEBUG=false

# Session/CSRF cookies are marked `Secure` when DJANGO_DEBUG is off. A Secure
# cookie is only sent over https, so running DJANGO_DEBUG=false while browsing
# over plain http://localhost silently drops the cookies (login "works" but the
# session never persists and every request 403s / logs you out). If you must run
# with DEBUG off over http, set this to false. Leave it unset in production
# (serve over https and set DJANGO_BEHIND_TLS_PROXY=true instead).
# DJANGO_COOKIE_SECURE=false

# Exercise app — optional Strava import.
# Without these, exercise CRUD works fine and Strava sync returns permission_denied.
STRAVA_CLIENT=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
# Optional: path where refreshed (rotated) Strava tokens are persisted as JSON.
MANGO_STRAVA_TOKEN_FILE=

# Optional: override the exercise SQLite database path (defaults to
# data/exercise/workouttracker.db).
MANGO_EXERCISE_DB=

# EMAIL OAUTH credentials for Gmail API access. These are optional and only needed if you want to use Gmail integration.
OAUTH_GMAIL_CLIENT_SECRET=
OAUTH_GMAIL_CLIENT_ID=

# EMAIL OAUTH credentials for Microsoft 365 API access. These are optional and only needed if you want to use M365 integration.
OAUTH_M365_CLIENT_ID=
OAUTH_M365_CLIENT_SECRET=

# Pin the OAuth callback URI sent to Google/M365. Without this, the Vite dev proxy (changeOrigin: true)
# makes Django see 127.0.0.1:32553 instead of the real host, causing a redirect_uri_mismatch error.
# Set this to the URI registered in Google Cloud Console → OAuth client → Authorized redirect URIs.
# Dev (Vite, default):  http://localhost:5173/api/mailbox/oauth/callback/
# Dev (Django direct):  http://localhost:32553/api/mailbox/oauth/callback/
MANGO_MAILBOX_OAUTH_REDIRECT=http://localhost:5173/api/mailbox/oauth/callback/
# Where to send the browser after the OAuth callback completes (defaults to /).
MANGO_MAILBOX_OAUTH_RETURN=http://localhost:5173/
