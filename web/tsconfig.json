{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@media-viewer/*": ["../utils/apps/media_viewer/frontend/*"],
      "@exercise/*": ["../utils/apps/exercise/frontend/*"],
      "@mailbox/*": ["../utils/apps/mailbox/frontend/*"],
      "@projectmanager/*": ["../utils/apps/projectmanager/frontend/*"],
      "@calendar/*": ["../utils/apps/calendar/frontend/*"],
      "@imdbspy/*": ["../utils/apps/imdbspy/frontend/*"],
      "@recipes/*": ["../utils/apps/recipes/frontend/*"],
      "@timekeeper/*": ["../utils/apps/timekeeper/frontend/*"],
      "lucide-react": ["./node_modules/lucide-react"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "@tanstack/react-router": ["./node_modules/@tanstack/react-router"],
      "pdfjs-dist": ["./node_modules/pdfjs-dist"]
    }
  },
  "include": [
    "src",
    "../utils/apps/media_viewer/frontend",
    "../utils/apps/exercise/frontend",
    "../utils/apps/mailbox/frontend",
    "../utils/apps/projectmanager/frontend",
    "../utils/apps/imdbspy/frontend",
    "../utils/apps/calendar/frontend",
    "../utils/apps/recipes/frontend",
    "../utils/apps/timekeeper/frontend"
  ],
  "// exclude": "Tests are not typechecked here — vitest transpiles them, and its own types resolve through the bundler aliases rather than tsconfig paths. App-module tests get the same treatment as src ones.",
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "../utils/apps/*/frontend/**/*.test.ts",
    "../utils/apps/*/frontend/**/*.test.tsx"
  ]
}
