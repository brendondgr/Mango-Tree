LLM_BASE_URL=http://localhost:9090/v1
LLM_MODEL=default-model
LLM_API_KEY=

# Exercise app — optional Strava import.
# Without these, exercise CRUD works fine and Strava sync returns permission_denied.
STRAVA_CLIENT=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
# Optional: path where refreshed (rotated) Strava tokens are persisted as JSON.
MANGO_STRAVA_TOKEN_FILE=

# Optional: override the exercise SQLite database path (defaults to
# data/exercise/workouttracker.db).
MANGO_EXERCISE_DB=
